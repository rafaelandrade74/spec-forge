{
  "name": "spec-forge",
  "private": true,
  "version": "0.1.0",
  "description": "MCP server + roadmap de especificações estilo spec-kit, persistido em PostgreSQL.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafaelandrade74/spec-forge.git"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:generate": "pnpm --filter @spec-forge/db generate",
    "db:migrate": "pnpm --filter @spec-forge/db migrate",
    "mcp:dev": "pnpm --filter @spec-forge/mcp-server dev",
    "mcp:dev:http": "pnpm --filter @spec-forge/mcp-server dev:http",
    "mcp:e2e": "pnpm --filter @spec-forge/mcp-server e2e",
    "web:dev": "pnpm --filter @spec-forge/web dev",
    "dev": "pnpm db:up && concurrently -n mcp,web -c blue,green \"pnpm mcp:dev:http\" \"pnpm web:dev\""
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
