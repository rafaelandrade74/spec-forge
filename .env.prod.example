# Copy to .env before running docker compose -f docker-compose.prod.yml up -d
# Generate a strong password, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Optional: override the host ports if 8787/3000 are already taken on your homelab
# MCP_HTTP_PORT_HOST=8787
# WEB_PORT_HOST=3000

# --- Using a Postgres you already run elsewhere instead of the bundled one ---
# Use docker-compose.external-db.yml instead of docker-compose.prod.yml (which has no
# postgres service of its own) and set DATABASE_URL to point at your existing instance,
# e.g. the one in docker-services/postgres. On Docker Desktop (Windows/Mac), reach the
# host's published port via host.docker.internal; on Linux add
# `extra_hosts: ["host.docker.internal:host-gateway"]` or use the host's LAN IP instead.
#
#   docker compose -f docker-compose.external-db.yml up -d --build
#
# DATABASE_URL=postgres://spec_forge:your-password@host.docker.internal:5432/spec_forge
