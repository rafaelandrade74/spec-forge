{
  "name": "@spec-forge/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "spec-forge-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx src/e2e.ts",
    "token:create": "tsx src/cli-token.ts create",
    "token:list": "tsx src/cli-token.ts list",
    "token:revoke": "tsx src/cli-token.ts revoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@spec-forge/core": "workspace:*",
    "@spec-forge/db": "workspace:*",
    "express": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
